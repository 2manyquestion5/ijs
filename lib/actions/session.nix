# Shared session actions
#
# PURPOSE: Defines session command behavior reused by Niri, Hyprland and Waybar.
# ROLE: Pure Nix constructor returning a package/executable.
# CUSTOMIZATION: Changes can affect lock, logout or shutdown across multiple desktops.

# Shared session actions.
#
# These scripts are generated by Nix and referenced using their
# full store paths, without depending on the shell's PATH.
#
# We use KDialog for confirmation because Dolphin already gives us
# a KDE/Qt-based workflow. Later, Noctalia can provide the UI instead.
#
# Important:
#   Shutdown affects the entire computer.
#   Host authorization still determines whether it is permitted.

{ pkgs, lib }:

let
  dialog = lib.getExe pkgs.kdePackages.kdialog;
  systemctl = lib.getExe' pkgs.systemd "systemctl";

  session = pkgs.writeShellScriptBin "portable-session" ''
    set -eu

    confirm() {
      ${dialog} --title "Session" --yesno "$1"
    }

    logout() {
      if confirm "Log out of this desktop session?"; then
        if [ -n "''${NIRI_SOCKET:-}" ]; then
          niri msg action quit
        elif [ -n "''${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
          uwsm stop
        else
          exit 1
        fi
      fi
    }

    shutdown() {
      if confirm "Shut down this computer?"; then
        ${systemctl} poweroff
      fi
    }

    case "''${1:-}" in
      logout)
        logout
        ;;
      shutdown)
        shutdown
        ;;
      menu)
        choice="$(${dialog} --title "Power" \
          --menu "Choose a session action" \
          logout "Log out" \
          shutdown "Shut down")" || exit 0

        case "$choice" in
          logout) logout ;;
          shutdown) shutdown ;;
        esac
        ;;
      *)
        echo "Unknown session action" >&2
        exit 2
        ;;
    esac
  '';

in
{
  # Package that Home Manager can install.
  package = session;

  # Absolute path for desktop integrations.
  executable = lib.getExe session;

  # Command generator used by keyboard adapters.
  command = action:
    "${lib.getExe session} ${lib.escapeShellArg action}";
}
